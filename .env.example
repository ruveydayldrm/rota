# Bu dosyayı .env olarak kopyala. Anahtarlar YALNIZCA backend'de kullanılır; frontend'e asla gitmez.

# Ana LLM: Google AI Studio ücretsiz anahtarı → https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Yedek LLM: Groq ücretsiz anahtarı → https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# İsteğe bağlı: OSRM erişilemezse OpenRouteService → https://openrouteservice.org/dev/#/signup
ORS_API_KEY=

# Nominatim/Overpass kullanım kuralı: kendini tanıtan bir User-Agent (iletişim bilgisiyle).
USER_AGENT=Rota/0.1 (open-source AI city guide; https://github.com/ruveydayldrm/rota)

CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_PER_MINUTE=6
